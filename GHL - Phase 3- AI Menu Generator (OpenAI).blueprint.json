        {
            "id": 7,
            "module": "google-email:sendAnEmail",
            "version": 4,
            "parameters": {
                "__IMTCONN__": 7317781
            },
            "mapper": {
                "to": [
                    "jjcavada1@gmail.com"
                ],
                "content": "<html><head><style>body{font-family:Arial,sans-serif;line-height:1.6;color:#333}h2{margin-top:25px}ol{padding-left:20px}li{margin-bottom:12px}p{margin-bottom:15px}</style></head><body><div style=\"max-width:700px;margin:0 auto;padding:20px;\"><div style=\"background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);color:white;padding:30px;border-radius:10px 10px 0 0;text-align:center;\"><h1 style=\"margin:0;font-size:28px;\">New Client Menu & Briefing Ready!</h1><p style=\"margin:10px 0 0 0;font-size:16px;opacity:0.9;\">Nutrition Intuition, LLC</p></div><div style=\"background:#f8f9fa;padding:25px;border:1px solid #e9ecef;\"><h2 style=\"color:#495057;margin-top:0;border-bottom:2px solid #667eea;padding-bottom:10px;\">Client Information</h2><p><strong>Name:</strong> {{2.fullName}}<br><strong>Email:</strong> {{2.email}}</p></div><div style=\"background:white;padding:25px;border:1px solid #e9ecef;border-top:none;\">{{3.data.choices[1].message.content}}</div><div style=\"background:#f8f9fa;padding:20px;border:1px solid #e9ecef;border-top:none;border-radius:0 0 10px 10px;text-align:center;\"><p style=\"margin:0;color:#6c757d;font-size:14px;\">View full details in <a href=\"https://app.gohighlevel.com\" style=\"color:#667eea;\">GoHighLevel Contact Record</a></p><p style=\"margin:10px 0 0 0;color:#adb5bd;font-size:12px;\">Generated automatically by Nutrition Intuition AI</p></div></div></body></html>",
                "subject": "New Menu & Chef Briefing - {{2.fullName}}",
                "bodyType": "rawHtml"
            },
